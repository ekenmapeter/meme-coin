APP_NAME="Pump Endless"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# SQLite (default) or MySQL/PostgreSQL for production
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meme_coin
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypt session payloads at rest (recommended for production).
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Force the session cookie over HTTPS only.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=
MEMCACHED_HOST=127.0.0.1

# Live BTC/SOL USD prices (CoinGecko). Set to false to use the admin-configured rates only.
CRYPTO_PRICE_FEED_ENABLED=true
CRYPTO_PRICE_FEED_URL=https://api.coingecko.com/api/v3/simple/price
CRYPTO_PRICE_FEED_MARKETS_URL=https://api.coingecko.com/api/v3/coins/markets
CRYPTO_PRICE_FEED_TTL=60
CRYPTO_PRICE_FEED_TIMEOUT=5

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is optional; transactional email is not wired up yet.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated IPs/CIDRs of reverse proxies in front of the app
# (e.g. your hosting proxy or CDN). Leave empty when not behind a proxy.
# TRUSTED_PROXIES=

# Redirect all insecure requests to HTTPS. Enable in production when serving
# over TLS. Behind a reverse proxy you must also set TRUSTED_PROXIES so the
# X-Forwarded-Proto header is honored.
# FORCE_HTTPS=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"